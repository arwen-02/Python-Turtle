import turtle

#Turtle for Drawing
mush=turtle.Turtle()
mush.speed(400)

#Mushroom's Top Part Body
mush.penup()
mush.pensize(15)
mush.goto(325,0)
mush.pendown()
mush.color("black","red")
mush.begin_fill()
mush.left(90)
mush.circle(325,180)
mush.left(10)
mush.circle(325,40)
mush.left(40)
mush.forward(428)
mush.left(40)
mush.circle(325,40)
mush.end_fill()

#Mushroom"s Bottom Part Body
mush.penup()
mush.pensize(13)
mush.goto(210,-160)
mush.pendown()
mush.color("black","#FFE4C4")
mush.begin_fill()
mush.right(177)
mush.forward(90)
for i in range(18):
	mush.right(3)
	mush.forward(5)
mush.right(10)
for i in range(60):
	mush.forward(5)
	mush.right(.6)
mush.right(10)
for i in range(18):
	mush.right(3)
	mush.forward(5)
mush.forward(90)
mush.right(63)
for i in range(90):
	mush.forward(5)
	mush.right(.8)
mush.end_fill()
	
